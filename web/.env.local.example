# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both are safe to expose to the browser (that is the point of the anon key);
# the site's rows are protected by the RLS policies in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
