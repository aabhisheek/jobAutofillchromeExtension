# Copy to .env and fill in, or set these in your host's dashboard.
#
# PORT and HOST control where it listens.
PORT=8787
HOST=0.0.0.0
NODE_ENV=production

# Google OAuth client id whose ID tokens this server will accept. Must match the
# client the extension signs in with (src/data/google-oauth.json).
GOOGLE_CLIENT_ID=818119178127-m1eibpeh0lqm4jpqe0rea40f720ollcb.apps.googleusercontent.com

# Secret used to sign session tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production; the server refuses to start without it.
SESSION_SECRET=replace-me

# How long a session stays valid, in days.
SESSION_TTL_DAYS=30

# Comma-separated browser origins allowed to call the API, in addition to any
# chrome-extension:// origin (always allowed) and localhost (development only).
ALLOWED_ORIGINS=
